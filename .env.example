# mock | playwright | selenium | browser_bridge
LOCAL_LLM_GLM_MODE=mock

# All web adapters share these GLM settings.
LOCAL_LLM_GLM_URL=https://your-internal-glm.example/
LOCAL_LLM_GLM_INPUT_SELECTOR=textarea
LOCAL_LLM_GLM_SUBMIT_SELECTOR=
# Default supports common assistant-role UIs and Streamlit chat messages.
LOCAL_LLM_GLM_RESPONSE_SELECTOR=[data-message-author-role='assistant'], [data-testid='stChatMessage']
LOCAL_LLM_GLM_USER_DATA_DIR=.browser-profile
LOCAL_LLM_GLM_HEADLESS=false
LOCAL_LLM_GLM_TIMEOUT_MS=120000

# Company Selenium example (keep the real internal URL only in your local .env):
# LOCAL_LLM_GLM_MODE=selenium
# LOCAL_LLM_GLM_URL=http://YOUR-INTERNAL-LLM:8501/
# LOCAL_LLM_GLM_TIMEOUT_MS=1800000
# LOCAL_LLM_EMBEDDING_MODE=disabled

LOCAL_LLM_DB_PATH=data/memory.db
LOCAL_LLM_TOP_K_CONTEXT=5

# Local SentenceTransformers-compatible folder. No automatic model download.
LOCAL_LLM_EMBEDDING_MODE=disabled
LOCAL_LLM_EMBEDDING_MODEL_PATH=
LOCAL_LLM_EMBEDDING_DEVICE=cpu
# Set prefixes only if required by your model (e.g. E5 query: / passage:).
LOCAL_LLM_EMBEDDING_QUERY_PREFIX=""
LOCAL_LLM_EMBEDDING_DOCUMENT_PREFIX=""
LOCAL_LLM_AGENT_WORKSPACE=data/workspace
LOCAL_LLM_AGENT_MAX_STEPS=8
# Recommended when the page exposes a selector visible only while generating.
LOCAL_LLM_GLM_STOP_SELECTOR=
LOCAL_LLM_GLM_STABLE_SECONDS=5

# Browser bridge: set a random local token in .env (do not commit).
# Also copy browser-extension/config.example.js -> config.js and use the same token.
LOCAL_LLM_BROWSER_BRIDGE_TOKEN=
LOCAL_LLM_SKILLS_DIR=skills
# Additional explicitly permitted folders, JSON array. Default is workspace only.
LOCAL_LLM_AGENT_ALLOWED_ROOTS=[]
# Mutating tools require explicit approval by default.
LOCAL_LLM_AGENT_REQUIRE_APPROVAL=true
LOCAL_LLM_AGENT_COMMAND_TIMEOUT=30
